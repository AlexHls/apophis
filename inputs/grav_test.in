<comment>
problem = Gravity accuracy test

<job>
problem_id = gravity_test

<parthenon/mesh>
refinement = static
multigrid = true
numlevel = 3
nghost = 2

nx1 = 32
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow

nx2 = 32
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow

nx3 = 32
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1=16
nx2=16
nx3=16

<parthenon/static_refinement1>
x1min = -0.25
x1max = 0.25
x2min = -0.25
x2max = 0.25
x3min = -0.25
x3max = 0.25
level = 2

<parthenon/time>
integrator = rk1
cfl = 0.4
tlim = 0.8
nlim = 1
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc
ncycle_out_mesh = -100

<hydro>
fluid = euler
eos = adiabatic
riemann = hlle
reconstruction = dc
gamma = 1.666666666666667 # gamma = C_p/C_v
scratch_level = 0 # 0 is actual scratch (tiny); 1 is HBM

<eos>
eos_type = ideal
gm1 = 0.666666667
Cv = 1.5

<refinement>
type                         = pressure_gradient
threshold_pressure_gradient  = 0.1

<problem>
rho0 = 1.0
r0 = 0.25
x0 = 0.05
y0 = 0.0
z0 = 0.0

<gravity>
type = poisson
gravity_constant = 1.0
solver = MGBiCGSTAB
flux_correct = false
diagonal_alpha = 0.0
boundary_prolongation=Quadratic

<gravity/solver_params>
precondition = true
max_iterations = 15
residual_tolerance = 1.e-8
print_per_step = false
smoother = SRJ2
do_FAS = true

<parthenon/output0>
file_type = hdf5
dt = 0.1
variables = gravity
