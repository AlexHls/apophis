<comment>
problem = Evrards collapse test

<job>
problem_id = evrards_collapse

<parthenon/mesh>
refinement = none 
multigrid = true
numlevel = 3
nghost = 2

nx1 = 128
x1min = -2.0
x1max = 2.0
ix1_bc = outflow
ox1_bc = outflow

nx2 = 128
x2min = -2.0
x2max = 2.0
ix2_bc = outflow
ox2_bc = outflow

nx3 = 1
x3min = -2.0
x3max = 2.0
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1=16
nx2=16
nx3=1

<parthenon/time>
integrator = rk2
cfl = 0.4
tlim = 1.6
nlim = 10000
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc
ncycle_out_mesh = -100

<hydro>
fluid = euler
eos = adiabatic
riemann = hllc
reconstruction = plm
gamma = 1.666666666666667 # gamma = C_p/C_v
scratch_level = 0 # 0 is actual scratch (tiny); 1 is HBM

<eos>
eos_type = ideal
gm1 = 0.666666667
Cv = 1.5

<refinement>
type                         = pressure_gradient
threshold_pressure_gradient  = 0.1

<problem>
mass = 1.0
radius = 1.0
u_therm = 0.05

<gravity>
type = poisson
gravity_constant = 1.0
solver = BiCGSTAB
flux_correct = true
diagonal_alpha = 0.0

<gravity/solver_params>
precondition = true
max_iterations = 15
residual_tolerance = 1.e-8
print_per_step = false
smoother = SRJ2
do_FAS = true

<parthenon/output0>
file_type = hdf5
dt = 0.1
variables = cons,prim,gravity

<parthenon/output1>
file_type = hst
dt = 0.05
packages = Hydro
