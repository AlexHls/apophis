<comment>
problem = Kelvin-Helmholtz instability

<job>
problem_id = kh

<problem/kh>
iprob  = 6
drat   = 0.1
amp    = 0.01            # amplitude of initial vy perturbation
vflow  = 1.0             # relative shear velocity of 2x interfaces
ofrac  = 0.65
ye     = 0.4983

<refinement>
type                     = unset
#type                     = xyvelocity_gradient 
threshold_xyvelocity_gradient  = 0.001

<parthenon/mesh>
refinement = none
numlevel = 3
nghost = 2

nx1 = 256
x1min = -1.0
x1max = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2 = 128
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic

nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<parthenon/meshblock>
nx1=64
nx2=128
nx3=1

<parthenon/time>
integrator = vl2
cfl = 0.4
tlim = 1.0
nlim = 100000
perf_cycle_offset = 2 # number of inital cycles not to be included in perf calc
ncycle_out_mesh = -1000

<hydro>
riemann = hllc
reconstruction = plm
nlset = 1
gamma = 1.666666666666667 # gamma = C_p/C_v
scratch_level = 0 # 0 is actual scratch (tiny); 1 is HBM
composition = ONe

<eos>
eos_type = ideal
gm1 = 0.66666666667
Cv = 1.5

<parthenon/output0>
file_type = hdf5
dt = 0.05
variables = prim
